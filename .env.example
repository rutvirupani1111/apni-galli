# Neon Postgres. Without it the app runs on a local PGlite folder at .data/galli.
DATABASE_URL=
# Signs session-free links (chit status, booking cancel, newsletter confirm). Any long random string.
TOKEN_HMAC_SECRET=
# Bearer for POST/GET /api/cron/tick (Vercel cron sends it automatically when set).
CRON_SECRET=
# Optional. When set, emails go out through Resend; otherwise they are written to outbox_emails.
RESEND_API_KEY=
MAIL_FROM=
# Optional. When set, public forms also require a Cloudflare Turnstile token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
